---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { SITE_CONFIG } from '../../data/config';

export const prerender = true;

export async function getStaticPaths() {
  const servicos = await getCollection('servicos');
  return servicos.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const especificacoes = [
  { item: "Matéria-Prima", valor: "Aço Carbono / Galvanizado Gerdau e CSN", icone: "🔩" },
  { item: "Acabamento", valor: "Primer Epóxi Anticorrosivo e Esmalte Especial", icone: "🎨" },
  { item: "Soldagem", valor: "Processo MIG/MAG industrial com alta penetração", icone: "⚡" },
  { item: "Precisão Dimensional", valor: "Fabricação sob gabarito com medição milimétrica", icone: "📐" },
  { item: "Região Atendida", valor: "Sorocaba, Votorantim, Salto e Itu com visita técnica", icone: "📍" },
  { item: "Condições de Pagamento", valor: "Condições facilitadas e combinadas no orçamento", icone: "💳" }
];

const aplicacoes = [
  {
    tipo: "Residencial & Condomínios",
    badge: "Casas e Vilas",
    icone: "🏡",
    descricao: "Casas térreas, sobrados e condomínios fechados em Sorocaba (Campolim, Wanel Ville, Granja Olga, Ibiti do Paço e Santa Rosália)."
  },
  {
    tipo: "Comercial & Varejo",
    badge: "Empresas e Lojas",
    icone: "🏬",
    descricao: "Lojas de rua, shopping centers, restaurantes, consultórios, farmácias e escritórios corporativos em avenidas movimentadas."
  },
  {
    tipo: "Industrial & Logístico",
    badge: "Galpões e Fábricas",
    icone: "🏭",
    descricao: "Galpões industriais, centros de distribuição e depósitos nas zonas industriais de Sorocaba (Éden, Aparecidinha e Cajuru)."
  }
];

const diferenciais = [
  {
    titulo: "Aço 100% Galvanizado",
    descricao: "Material com certificação que bloqueia a corrosão, resistindo à umidade e calor característicos de Sorocaba."
  },
  {
    titulo: "Solda MIG/MAG Reforçada",
    descricao: "Soldagem contínua com fusão profunda, lixamento fino e acabamento sem rebarbas ou porosidades aparentes."
  },
  {
    titulo: "Tratamento Primer Anticorrosivo",
    descricao: "Camada química de ancoragem para fixação perfeita da pintura, impedindo descascamentos precoces."
  },
  {
    titulo: "Fixação e Chumbamento Pesado",
    descricao: "Ancoragem química ou buchas de aço na estrutura de concreto para máxima solidez e estabilidade."
  }
];

const passos = [
  {
    numero: "01",
    titulo: "Contato no WhatsApp",
    descricao: "Envie fotos do local, medidas preliminares ou o modelo que você deseja executar."
  },
  {
    numero: "02",
    titulo: "Medição Técnica no Imóvel",
    descricao: "Nosso técnico vai até seu endereço em Sorocaba sem custo para checar níveis, prumos e vãos."
  },
  {
    numero: "03",
    titulo: "Fabricação com Gabarito",
    descricao: "Corte, soldagem e aplicação de primer de proteção com maquinário moderno em nossa oficina."
  },
  {
    numero: "04",
    titulo: "Instalação e Entrega",
    descricao: "Montagem limpa, testes de alinhamento e finalização com máxima atenção aos detalhes."
  }
];

const faqsServico = [
  {
    pergunta: "A visita técnica e o orçamento têm custo em Sorocaba?",
    resposta: "Não! A visita técnica para medição e avaliação é totalmente gratuita em qualquer bairro de Sorocaba e Votorantim."
  },
  {
    pergunta: "Qual é o prazo médio para fabricação e entrega?",
    resposta: "O prazo varia conforme o porte e as especificações do projeto, sendo combinado com clareza antes do início da fabricação."
  },
  {
    pergunta: "Vocês executam modelos personalizados trazidos por arquiteto?",
    resposta: "Com certeza! Fabricamos sob medida seguindo plantas, fotos de referência ou projetos arquitetônicos autorais."
  },
  {
    pergunta: "Quais regiões são atendidas pela equipe?",
    resposta: "Atendemos toda a cidade de Sorocaba, além de Votorantim, Salto, Itu, Araçoiaba da Serra e cidades vizinhas."
  }
];

const whatsappUrl = SITE_CONFIG.whatsappUrl;
---

<Layout
  title={`${entry.data.title} | Serralheria em Sorocaba`}
  description={entry.data.description}
>
  <main class="bg-slate-50">
    <!-- 1. HERO DO SERVIÇO (Contraste escuro industrial sofisticado com detalhes amarelos) -->
    <section class="relative bg-gradient-to-b from-gray-950 via-gray-900 to-gray-950 text-white py-16 lg:py-24 border-b border-gray-800 overflow-hidden">
      <div class="container mx-auto px-6 md:px-12 relative z-10">
        <!-- Breadcrumb estilizado -->
        <nav class="mb-6 flex flex-wrap items-center gap-2 text-xs sm:text-sm text-gray-400 font-medium">
          <a href="/" class="hover:text-primary transition-colors">Início</a>
          <span class="text-gray-600">/</span>
          <a href="/servicos" class="hover:text-primary transition-colors">Serviços</a>
          <span class="text-gray-600">/</span>
          <span class="text-primary font-semibold">{entry.data.title}</span>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
          <!-- Coluna Esquerda: Informações Principais -->
          <div class="lg:col-span-7">
            {entry.data.badge && (
              <span class="inline-flex items-center gap-1.5 py-1 px-3.5 mb-6 text-xs font-bold uppercase tracking-wider bg-primary/20 text-primary border border-primary/40 rounded-full shadow-inner">
                <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
                {entry.data.badge}
              </span>
            )}

            <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-tight mb-6">
              {entry.data.title}
            </h1>

            <p class="text-base sm:text-xl text-gray-300 leading-relaxed max-w-2xl mb-8 font-normal">
              {entry.data.description}
            </p>

            <!-- Selos rápidos de autoridade -->
            <div class="flex flex-wrap gap-2.5 sm:gap-3 mb-10">
              <span class="inline-flex items-center text-xs font-semibold px-3 py-1.5 rounded-lg bg-gray-800/90 border border-gray-700 text-gray-200">
                🛡️ Aço Galvanizado Gerdau/CSN
              </span>
              <span class="inline-flex items-center text-xs font-semibold px-3 py-1.5 rounded-lg bg-gray-800/90 border border-gray-700 text-gray-200">
                📐 Visita Grátis em Sorocaba
              </span>
              <span class="inline-flex items-center text-xs font-semibold px-3 py-1.5 rounded-lg bg-gray-800/90 border border-gray-700 text-gray-200">
                ⚡ Soldagem Técnica MIG/MAG
              </span>
              <span class="inline-flex items-center text-xs font-semibold px-3 py-1.5 rounded-lg bg-gray-800/90 border border-gray-700 text-gray-200">
                🎨 Primer Anticorrosivo
              </span>
            </div>

            <!-- Botões de Ação Hero -->
            <div class="flex flex-col sm:flex-row gap-4">
              <a
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center px-8 py-4 text-base font-black text-accent bg-primary hover:bg-yellow-400 rounded-2xl shadow-xl shadow-primary/25 hover:scale-105 active:scale-95 transition-all duration-300 text-center"
              >
                <svg class="w-5 h-5 mr-3 shrink-0" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                </svg>
                Pedir Orçamento no WhatsApp
              </a>
              <a
                href="#especificacoes"
                class="inline-flex items-center justify-center px-8 py-4 text-base font-bold text-gray-200 bg-gray-800/80 hover:bg-gray-800 border border-gray-700 rounded-2xl hover:scale-105 active:scale-95 transition-all duration-300 text-center"
              >
                Ver Ficha Técnica
              </a>
            </div>
          </div>

          <!-- Coluna Direita: Card Resumo Técnico do Projeto -->
          <div class="lg:col-span-5">
            <div class="bg-gradient-to-b from-gray-900 via-gray-950 to-gray-900 border border-gray-800 rounded-3xl p-8 sm:p-10 shadow-2xl relative overflow-hidden">
              <div class="flex items-center justify-between pb-6 border-b border-gray-800 mb-6">
                <div>
                  <span class="text-xs font-bold uppercase tracking-wider text-primary">Serralheria Especializada</span>
                  <h3 class="text-xl font-black text-white">Resumo do Serviço</h3>
                </div>
                <span class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-400 text-xs font-bold border border-emerald-500/40">
                  <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                  Disponível
                </span>
              </div>

              <div class="space-y-4 text-sm">
                <div class="flex justify-between items-center py-2 border-b border-gray-800/60">
                  <span class="text-gray-400">Atendimento Local</span>
                  <span class="font-bold text-white text-right">Sorocaba e Região</span>
                </div>
                <div class="flex justify-between items-center py-2 border-b border-gray-800/60">
                  <span class="text-gray-400">Visita e Medição</span>
                  <span class="font-bold text-emerald-400 text-right">Sem Custo</span>
                </div>
                <div class="flex justify-between items-center py-2 border-b border-gray-800/60">
                  <span class="text-gray-400">Tempo de Resposta</span>
                  <span class="font-bold text-white text-right">Menos de 2 horas</span>
                </div>
                <div class="flex justify-between items-center py-2 border-b border-gray-800/60">
                  <span class="text-gray-400">Padrão Construtivo</span>
                  <span class="font-bold text-white text-right">Normas ABNT</span>
                </div>
                <div class="flex justify-between items-center py-2">
                  <span class="text-gray-400">Soldagem Industrial</span>
                  <span class="font-bold text-primary text-right">MIG/MAG Reforçada</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. CONTEÚDO TÉCNICO & SIDEBAR FLUTUANTE (Layout em 2 colunas para preencher a tela) -->
    <section class="py-16 lg:py-24 bg-slate-100/70 border-b border-gray-200">
      <div class="container mx-auto px-6 md:px-12">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
          
          <!-- Coluna Principal (Conteúdo da página) -->
          <div class="lg:col-span-8 space-y-10">
            <!-- Artigo Técnico Renderizado do Markdown com Design Polido -->
            <div class="bg-white rounded-3xl p-8 sm:p-12 border border-gray-200/80 shadow-md">
              <div class="flex items-center gap-2 mb-6 text-xs font-bold uppercase tracking-wider text-secondary">
                <span class="w-2.5 h-2.5 rounded-full bg-secondary"></span>
                Detalhamento Técnico do Projeto
              </div>
              <article class="prose prose-lg max-w-none text-gray-700 prose-headings:font-black prose-headings:tracking-tight prose-headings:text-gray-900 prose-h2:text-2xl sm:prose-h2:text-3xl prose-h2:border-b prose-h2:border-gray-100 prose-h2:pb-4 prose-h3:text-xl prose-a:text-secondary prose-strong:text-gray-900 prose-ul:list-disc prose-li:text-gray-600">
                <Content />
              </article>
            </div>

            <!-- Card: Diferenciais de Fabricação da Serralheria -->
            <div class="bg-white rounded-3xl p-8 sm:p-10 border border-gray-200/80 shadow-md">
              <span class="text-xs font-bold uppercase tracking-wider text-secondary block mb-2">
                Qualidade de Ponta a Ponta
              </span>
              <h3 class="text-2xl font-black text-gray-900 mb-6 tracking-tight">
                Diferenciais Construtivos em Nossas Estruturas
              </h3>
              
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                {diferenciais.map((dif) => (
                  <div class="p-5 rounded-2xl bg-slate-50 border border-gray-200/70 hover:border-primary/60 transition-all">
                    <h4 class="font-black text-gray-900 text-base mb-2 flex items-center gap-2">
                      <span class="text-secondary font-bold">✓</span>
                      {dif.titulo}
                    </h4>
                    <p class="text-xs sm:text-sm text-gray-600 leading-relaxed font-normal">
                      {dif.descricao}
                    </p>
                  </div>
                ))}
              </div>
            </div>

            <!-- Card: Passo a Passo do Pedido (Processo Transparente) -->
            <div class="bg-white rounded-3xl p-8 sm:p-10 border border-gray-200/80 shadow-md">
              <span class="text-xs font-bold uppercase tracking-wider text-secondary block mb-2">
                Simples e Transparente
              </span>
              <h3 class="text-2xl font-black text-gray-900 mb-8 tracking-tight">
                Como Funciona: Do Orçamento à Instalação
              </h3>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                {passos.map((passo) => (
                  <div class="relative p-6 rounded-2xl bg-gradient-to-br from-slate-50 to-gray-50 border border-gray-200/80">
                    <span class="text-3xl font-black text-secondary/30 block mb-2">
                      {passo.numero}
                    </span>
                    <h4 class="font-black text-gray-900 text-base mb-2">
                      {passo.titulo}
                    </h4>
                    <p class="text-xs sm:text-sm text-gray-600 leading-relaxed font-normal">
                      {passo.descricao}
                    </p>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <!-- Coluna Lateral Flutuante (Sidebar com CTAs) -->
          <div class="lg:col-span-4 space-y-8 lg:sticky lg:top-28">
            <!-- Card 1: Orçamento Rápido WhatsApp -->
            <div class="bg-gradient-to-b from-gray-900 via-gray-950 to-gray-900 text-white rounded-3xl p-8 border border-gray-800 shadow-xl relative overflow-hidden">
              <div class="relative z-10">
                <span class="inline-block py-1 px-3 bg-primary/20 text-primary border border-primary/40 font-bold text-xs uppercase tracking-wider rounded-full mb-4">
                  Resposta Ágil
                </span>
                <h3 class="text-2xl font-black text-white tracking-tight mb-3">
                  Gostou Deste Projeto?
                </h3>
                <p class="text-xs sm:text-sm text-gray-300 leading-relaxed mb-6 font-normal">
                  Chame agora no WhatsApp para tirar dúvidas de medidas e agendar uma visita técnica sem compromisso no seu imóvel.
                </p>

                <a
                  href={whatsappUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full inline-flex items-center justify-center p-5 text-sm sm:text-base font-black text-accent bg-primary hover:bg-yellow-400 rounded-2xl shadow-lg shadow-primary/25 hover:scale-105 active:scale-95 transition-all duration-300 text-center mb-4"
                >
                  <svg class="w-5 h-5 mr-2 shrink-0" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                  </svg>
                  Conversar no WhatsApp
                </a>

                <p class="text-xs text-gray-400 text-center leading-relaxed">
                  Atendimento: Seg. a Sex. 09h às 17h | Sáb. 08h às 13h
                </p>
              </div>
            </div>

            <!-- Card 2: Compromisso e Diferenciais -->
            <div class="bg-white rounded-3xl p-8 border border-gray-200/80 shadow-md">
              <h4 class="text-lg font-black text-gray-900 tracking-tight mb-4">
                Compromisso com o Cliente
              </h4>
              <ul class="space-y-3 text-xs sm:text-sm text-gray-600 font-normal">
                <li class="flex items-start gap-2.5">
                  <span class="text-emerald-500 font-bold shrink-0">✓</span>
                  <span>Visita técnica gratuita em toda Sorocaba e Votorantim.</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-emerald-500 font-bold shrink-0">✓</span>
                  <span>Soldagem de alta fusão e acabamento sem rebarbas.</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-emerald-500 font-bold shrink-0">✓</span>
                  <span>Aço 100% galvanizado de usinas certificadas (Gerdau / CSN).</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-emerald-500 font-bold shrink-0">✓</span>
                  <span>Aplicação de fundo antiferrugem para máxima durabilidade.</span>
                </li>
              </ul>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 3. ESPECIFICAÇÕES TÉCNICAS (Ficha Técnica com Ícones e Cards Contrastantes) -->
    <section id="especificacoes" class="py-20 lg:py-28 bg-white border-b border-gray-200">
      <div class="container mx-auto px-6 md:px-12">
        <div class="max-w-5xl mx-auto">
          <div class="max-w-2xl mb-14">
            <span class="text-xs sm:text-sm font-bold uppercase tracking-widest text-secondary block mb-3">
              Ficha Técnica Construtiva
            </span>
            <h2 class="text-2xl sm:text-4xl font-black text-gray-900 tracking-tighter leading-tight mb-4">
              Especificações e Padrões de Engenharia
            </h2>
            <p class="text-base text-gray-600 font-normal">
              Todos os materiais e procedimentos atendem com rigor às normas brasileiras de segurança e durabilidade.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {especificacoes.map((spec) => (
              <div class="bg-gradient-to-b from-slate-50 to-gray-50 border border-gray-200/90 rounded-3xl p-7 shadow-sm hover:shadow-md hover:border-primary/60 transition-all flex flex-col justify-between">
                <div>
                  <div class="w-12 h-12 rounded-2xl bg-white border border-gray-200 flex items-center justify-center text-xl mb-4 shadow-sm">
                    {spec.icone}
                  </div>
                  <span class="text-xs font-bold text-secondary uppercase tracking-wider block mb-1">
                    {spec.item}
                  </span>
                  <p class="text-base font-bold text-gray-900 leading-snug">
                    {spec.valor}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 4. BENEFÍCIOS & APLICAÇÕES REAIS -->
    <section class="py-20 lg:py-28 bg-slate-100/70 border-b border-gray-200">
      <div class="container mx-auto px-6 md:px-12">
        <div class="max-w-5xl mx-auto">
          <div class="max-w-2xl mb-14">
            <span class="text-xs sm:text-sm font-bold uppercase tracking-widest text-secondary block mb-3">
              Onde Instalamos
            </span>
            <h2 class="text-2xl sm:text-4xl font-black text-gray-900 tracking-tighter leading-tight mb-4">
              Aplicações em Sorocaba e Região
            </h2>
            <p class="text-base text-gray-600 font-normal">
              Projetamos e executamos ferragens sob medida para os principais segmentos da nossa cidade.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {aplicacoes.map((app) => (
              <div class="bg-white border border-gray-200/80 rounded-3xl p-8 sm:p-10 shadow-sm hover:shadow-xl hover:border-primary/50 transition-all duration-300 flex flex-col justify-between">
                <div>
                  <div class="w-14 h-14 rounded-2xl bg-slate-50 border border-gray-200 flex items-center justify-center text-2xl mb-6 shadow-inner">
                    {app.icone}
                  </div>
                  <span class="text-[11px] font-bold uppercase tracking-wider text-secondary bg-secondary/10 px-3 py-1 rounded-full inline-block mb-3">
                    {app.badge}
                  </span>
                  <h3 class="text-xl font-black text-gray-900 mb-3 tracking-tight">
                    {app.tipo}
                  </h3>
                  <p class="text-sm text-gray-600 leading-relaxed font-normal">
                    {app.descricao}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 5. PERGUNTAS FREQUENTES ESPECÍFICAS -->
    <section class="py-20 lg:py-28 bg-white border-b border-gray-200">
      <div class="container mx-auto px-6 md:px-12">
        <div class="max-w-4xl mx-auto">
          <div class="text-center max-w-2xl mx-auto mb-14">
            <span class="text-xs sm:text-sm font-bold uppercase tracking-widest text-secondary block mb-3">
              Dúvidas Comuns
            </span>
            <h2 class="text-2xl sm:text-4xl font-black text-gray-900 tracking-tighter leading-tight">
              Perguntas Frequentes Sobre o Serviço
            </h2>
          </div>

          <div class="space-y-4">
            {faqsServico.map((faq) => (
              <div class="bg-slate-50 border border-gray-200/90 rounded-2xl p-6 sm:p-8 hover:border-gray-300 transition-all">
                <h4 class="text-base sm:text-lg font-black text-gray-900 mb-2 flex items-start gap-3">
                  <span class="text-secondary font-bold">❓</span>
                  <span>{faq.pergunta}</span>
                </h4>
                <p class="text-sm text-gray-600 leading-relaxed pl-8 font-normal">
                  {faq.resposta}
                </p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 6. CTA DE FECHAMENTO (Mesmo tom escuro da imagem: bg-gradient-to-b from-gray-900 via-gray-950 to-gray-900) -->
    <section class="relative py-20 lg:py-28 bg-gradient-to-b from-gray-900 via-gray-950 to-gray-900 text-white border-t border-b border-gray-800 overflow-hidden">
      <div class="container mx-auto px-6 md:px-12 text-center max-w-4xl relative z-10">
        <span class="inline-block py-1.5 px-4 bg-primary/20 text-primary font-bold text-xs uppercase tracking-widest rounded-full mb-6 border border-primary/40 shadow-inner">
          Atendimento Rápido e Sem Burocracia
        </span>
        <h2 class="text-2xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight mb-6">
          Solicite seu orçamento para <span class="text-primary">{entry.data.title}</span>
        </h2>
        <p class="text-base sm:text-xl text-gray-300 leading-relaxed max-w-2xl mx-auto mb-10 font-normal">
          Receba um retorno técnico rápido com valores justos, prazos reais e possibilidade de visita no local.
        </p>

        <div class="flex items-center justify-center">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center w-full sm:w-auto px-10 py-5 text-base font-black text-accent bg-primary hover:bg-yellow-400 rounded-2xl shadow-xl shadow-primary/25 hover:scale-105 active:scale-95 transition-all duration-300"
          >
            <svg class="w-6 h-6 mr-3 shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            Solicitar Orçamento no WhatsApp
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
