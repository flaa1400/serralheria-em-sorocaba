---
import Layout from '../layouts/Layout.astro';
import { SITE_CONFIG } from '../data/config';
---

<Layout
  title={`Contato e Orçamento | ${SITE_CONFIG.businessName}`}
  description={`Entre em contato com a ${SITE_CONFIG.businessName}. Atendimento rápido via WhatsApp ou formulário com visita técnica no local.`}
>
  <main class="bg-slate-50">
    <!-- HERO CONTATO (Dark Hero Industrial) -->
    <section class="relative bg-gradient-to-b from-gray-950 via-gray-900 to-gray-950 text-white py-16 lg:py-24 border-b border-gray-800 overflow-hidden">
      <div class="container mx-auto px-6 md:px-12 relative z-10 text-center max-w-4xl mx-auto">
        <span class="inline-block py-1.5 px-4 bg-primary/20 text-primary font-black text-xs uppercase tracking-widest rounded-full border border-primary/40 shadow-inner mb-6">
          Atendimento Rápido
        </span>
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-tight mb-6">
          Orçamentos e Atendimento em Sorocaba e Região
        </h1>
        <p class="text-base sm:text-xl text-gray-300 leading-relaxed font-normal max-w-2xl mx-auto">
          Envie os dados do seu projeto, solicite uma visita no local ou converse em tempo real com nossa equipe técnica pelo WhatsApp.
        </p>
      </div>
    </section>

    <!-- ÁREA DO FORMULÁRIO E NAP -->
    <section class="py-16 lg:py-24 border-b border-gray-200">
      <div class="container mx-auto px-6 md:px-12">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
          <!-- Coluna Esquerda: NAP (Name, Address, Phone) & WhatsApp CTA -->
          <div class="lg:col-span-5 space-y-8">
            <!-- Card de Ação Rápida WhatsApp -->
            <div class="relative bg-gradient-to-b from-gray-900 via-gray-950 to-gray-900 text-white rounded-3xl p-8 sm:p-10 border border-gray-800 shadow-2xl overflow-hidden hover:border-gray-700 transition-all">
              <div class="relative z-10">
                <span class="inline-block py-1.5 px-3.5 bg-primary/20 text-primary border border-primary/40 font-black text-xs uppercase tracking-wider rounded-full mb-6 shadow-inner">
                  Resposta Mais Rápida
                </span>
                <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight mb-4">
                  Atendimento Direto no WhatsApp
                </h2>
                <p class="text-gray-300 text-sm sm:text-base leading-relaxed mb-8 font-normal">
                  Mande fotos do vão, medidas aproximadas ou a ideia do portão ou mezanino para um retorno ágil da equipe de engenharia.
                </p>
                <a
                  href={SITE_CONFIG.whatsappUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full inline-flex items-center justify-center p-6 sm:p-8 text-base font-black text-accent bg-primary hover:bg-yellow-400 rounded-2xl shadow-lg shadow-primary/25 hover:scale-105 active:scale-95 transition-all duration-300 text-center"
                >
                  <svg class="w-6 h-6 mr-3 shrink-0" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                  </svg>
                  Iniciar Conversa no WhatsApp
                </a>
              </div>
            </div>

            <!-- BLOCO DADOS DA EMPRESA (Consumindo SITE_CONFIG) -->
            <div class="bg-white border border-gray-200/90 rounded-3xl p-8 sm:p-10 space-y-6 shadow-sm">
              <h3 class="text-xl font-black text-gray-900 border-b border-gray-100 pb-4">
                Dados da Empresa
              </h3>

              <div class="space-y-4 text-sm text-gray-600">
                <div>
                  <p class="text-xs uppercase tracking-wider font-bold text-secondary">Endereço Operacional</p>
                  <p class="font-semibold text-gray-800">{SITE_CONFIG.address.fullAddress}</p>
                </div>

                <div>
                  <p class="text-xs uppercase tracking-wider font-bold text-secondary">WhatsApp Comercial</p>
                  <p class="font-semibold text-gray-800">
                    WhatsApp: <a href={SITE_CONFIG.whatsappUrl} target="_blank" rel="noopener noreferrer" class="text-secondary hover:underline">{SITE_CONFIG.whatsapp}</a>
                  </p>
                </div>

                <div>
                  <p class="text-xs uppercase tracking-wider font-bold text-secondary">E-mail Comercial</p>
                  <p class="font-semibold text-gray-800">{SITE_CONFIG.email}</p>
                </div>

                <div>
                  <p class="text-xs uppercase tracking-wider font-bold text-secondary">Horário de Funcionamento</p>
                  <p class="font-semibold text-gray-800">{SITE_CONFIG.openingHours.days}</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Coluna Direita: Formulário de Contato -->
          <div class="lg:col-span-7 bg-white border border-gray-200/90 rounded-3xl p-8 sm:p-10 lg:p-12 shadow-md">
          <span class="text-xs font-bold uppercase tracking-wider text-secondary block mb-2">
            Formulário Online
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-gray-900 mb-4 tracking-tight">
            Solicitar Proposta Técnica
          </h2>
          <p class="text-base text-gray-600 mb-8">
            Preencha os campos abaixo para iniciar seu atendimento diretamente pelo WhatsApp da empresa com todas as informações do seu projeto.
          </p>

          <form id="form-contato" data-whatsapp={SITE_CONFIG.whatsappRaw} class="space-y-6">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="nome" class="block text-sm font-bold text-gray-900 mb-2">Seu Nome *</label>
                <input
                  type="text"
                  id="nome"
                  name="nome"
                  required
                  placeholder="Nome completo"
                  class="w-full px-5 py-4 text-base rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-secondary focus:border-transparent transition-all"
                />
              </div>

              <div>
                <label for="telefone" class="block text-sm font-bold text-gray-900 mb-2">WhatsApp / Celular *</label>
                <input
                  type="tel"
                  id="telefone"
                  name="telefone"
                  required
                  placeholder="(15) 99999-9999"
                  class="w-full px-5 py-4 text-base rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-secondary focus:border-transparent transition-all"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="bairro" class="block text-sm font-bold text-gray-900 mb-2">Bairro ou Cidade</label>
                <input
                  type="text"
                  id="bairro"
                  name="bairro"
                  placeholder="Ex: Campolim, Sorocaba"
                  class="w-full px-5 py-4 text-base rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-secondary focus:border-transparent transition-all"
                />
              </div>

              <div>
                <label for="servico" class="block text-sm font-bold text-gray-900 mb-2">Serviço de Interesse</label>
                <select
                  id="servico"
                  name="servico"
                  class="w-full px-5 py-4 text-base rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-secondary focus:border-transparent transition-all bg-white"
                >
                  <option value="Portão Automático / Basculante">Portão Automático / Basculante</option>
                  <option value="Estrutura Metálica ou Mezanino">Estrutura Metálica ou Mezanino</option>
                  <option value="Cobertura Térmica / Telha Sanduíche">Cobertura Térmica / Telha Sanduíche</option>
                  <option value="Grades de Proteção e Esquadrias">Grades de Proteção e Esquadrias</option>
                  <option value="Reforma e Manutenção (Cabos/Motor)">Reforma e Manutenção (Cabos/Motor)</option>
                  <option value="Outro Projeto Personalizado">Outro Projeto Personalizado</option>
                </select>
              </div>
            </div>

            <div>
              <label for="mensagem" class="block text-sm font-bold text-gray-900 mb-2">Descreva seu Projeto</label>
              <textarea
                id="mensagem"
                name="mensagem"
                rows="4"
                placeholder="Informe medidas estimadas, se o local já possui estrutura pronta ou se precisa de visita técnica para medição..."
                class="w-full px-5 py-4 text-base rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-secondary focus:border-transparent transition-all"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full p-6 sm:p-7 text-base font-black text-accent bg-primary hover:bg-yellow-400 rounded-2xl shadow-lg shadow-primary/20 hover:scale-105 active:scale-95 transition-all duration-300 text-center cursor-pointer flex items-center justify-center gap-3"
            >
              <svg class="w-6 h-6 shrink-0 fill-current text-accent" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
              </svg>
              <span>Enviar Solicitação no WhatsApp</span>
            </button>
          </form>
        </div>
      </div>
    </section>
  </main>

  <script>
    const form = document.getElementById('form-contato') as HTMLFormElement;
    const telInput = document.getElementById('telefone') as HTMLInputElement;

    // Máscara dinâmica para o telefone (DDD + 8 ou 9 dígitos)
    telInput?.addEventListener('input', (e) => {
      let value = (e.target as HTMLInputElement).value.replace(/\D/g, '');
      if (value.length > 11) value = value.slice(0, 11);

      if (value.length > 6) {
        value = `(${value.slice(0, 2)}) ${value.slice(2, 7)}-${value.slice(7)}`;
      } else if (value.length > 2) {
        value = `(${value.slice(0, 2)}) ${value.slice(2)}`;
      } else if (value.length > 0) {
        value = `(${value}`;
      }
      (e.target as HTMLInputElement).value = value;
    });

    // Envio do formulário direto para o WhatsApp
    form?.addEventListener('submit', (e) => {
      e.preventDefault();

      const nome = (document.getElementById('nome') as HTMLInputElement)?.value.trim();
      const telefone = (document.getElementById('telefone') as HTMLInputElement)?.value.trim();
      const bairro = (document.getElementById('bairro') as HTMLInputElement)?.value.trim();
      const servico = (document.getElementById('servico') as HTMLSelectElement)?.value;
      const mensagem = (document.getElementById('mensagem') as HTMLTextAreaElement)?.value.trim();
      const whatsappRaw = form.dataset.whatsapp || '5511964299548';

      let texto = `Olá vim do Site Serralheria Aço na medida, e gostaria de um Orçamento.\n\n`;
      texto += `👤 *Nome:* ${nome}\n`;
      texto += `📱 *Telefone/WhatsApp:* ${telefone}\n`;
      if (bairro) {
        texto += `📍 *Bairro / Região:* ${bairro}\n`;
      }
      if (servico) {
        texto += `🛠️ *Serviço de Interesse:* ${servico}\n`;
      }
      if (mensagem) {
        texto += `📝 *Detalhes do Projeto:* ${mensagem}\n`;
      }

      const whatsappUrl = `https://wa.me/${whatsappRaw}?text=${encodeURIComponent(texto)}`;
      window.open(whatsappUrl, '_blank');
    });
  </script>
</Layout>
