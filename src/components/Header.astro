---
import { SITE_CONFIG } from '../data/config';
---

<header class="sticky top-0 z-50 w-full bg-white/95 backdrop-blur-md border-b border-gray-100 transition-all duration-200">
  <div class="container mx-auto px-6 md:px-12">
    <div class="flex items-center justify-between h-20">
      <!-- Logo / Identidade -->
      <a href="/" class="flex items-center gap-3 group hover:scale-105 active:scale-95 transition-all duration-300">
        <div class="w-11 h-11 rounded-xl bg-secondary flex items-center justify-center text-primary font-black text-xl shadow-md shadow-secondary/20">
          AM
        </div>
        <div class="flex flex-col">
          <span class="text-lg font-black tracking-tighter text-gray-900 group-hover:text-secondary transition-colors leading-none">
            {SITE_CONFIG.businessName}
          </span>
          <span class="text-xs font-semibold text-gray-500 tracking-wider uppercase mt-1">
            Sorocaba & Região
          </span>
        </div>
      </a>

      <!-- Navegação Desktop Completa -->
      <nav class="hidden md:flex items-center gap-7">
        <a href="/" class="text-sm font-bold text-gray-700 hover:text-secondary hover:scale-105 active:scale-95 transition-all">
          Início
        </a>
        <a href="/servicos" class="text-sm font-bold text-gray-700 hover:text-secondary hover:scale-105 active:scale-95 transition-all">
          Serviços
        </a>
        <a href="/sobre" class="text-sm font-bold text-gray-700 hover:text-secondary hover:scale-105 active:scale-95 transition-all">
          Sobre Nós
        </a>
        <a href="/contato" class="text-sm font-bold text-gray-700 hover:text-secondary hover:scale-105 active:scale-95 transition-all">
          Contato
        </a>
      </nav>

      <!-- CTA Desktop & Botão Hamburguer Mobile -->
      <div class="flex items-center gap-3">
        <a
          href={SITE_CONFIG.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center justify-center px-5 py-2.5 text-sm font-black text-accent bg-primary hover:bg-yellow-400 rounded-xl shadow-lg shadow-primary/25 hover:scale-105 active:scale-95 transition-all duration-300"
        >
          <svg class="w-4 h-4 mr-2 shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          WhatsApp
        </a>

        <!-- Botão Abrir Menu Mobile -->
        <button
          id="btn-open-mobile"
          type="button"
          aria-label="Abrir Menu Principal"
          class="md:hidden inline-flex items-center justify-center w-12 h-12 rounded-xl bg-gray-100 text-gray-900 hover:bg-gray-200 hover:scale-105 active:scale-95 transition-all"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- MENU MOBILE DRAWER (Fora do <header> para não sofrer com o stacking context de backdrop-filter) -->
<div
  id="mobile-drawer"
  class="fixed inset-0 z-[99999] bg-gray-950 hidden flex-col justify-between p-6 sm:p-8 text-white overflow-y-auto"
>
  <!-- Topo do Drawer com Logo e Botão 'X' -->
  <div class="flex items-center justify-between border-b border-gray-800 pb-5">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-secondary flex items-center justify-center text-primary font-black text-lg shadow-md">
        AM
      </div>
      <div class="flex flex-col">
        <span class="text-base font-black tracking-tight text-white leading-tight">
          {SITE_CONFIG.businessName}
        </span>
        <span class="text-xs text-gray-400">
          Sorocaba & Região
        </span>
      </div>
    </div>

    <button
      id="btn-close-mobile"
      type="button"
      aria-label="Fechar Menu"
      class="w-11 h-11 rounded-xl bg-gray-900 border border-gray-800 text-gray-200 hover:text-primary hover:border-primary/50 flex items-center justify-center active:scale-95 transition-all"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Links Centrais em Formato de Cards de Alto Contraste -->
  <nav class="flex flex-col gap-3 my-6">
    <a
      href="/"
      class="mobile-link flex items-center justify-between p-4 rounded-2xl bg-gray-900 border border-gray-800 text-lg font-bold text-white hover:text-primary hover:border-primary/50 hover:bg-gray-800/80 transition-all"
    >
      <span class="flex items-center gap-3">
        <span class="w-2.5 h-2.5 rounded-full bg-primary"></span>
        Início
      </span>
      <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>

    <a
      href="/servicos"
      class="mobile-link flex items-center justify-between p-4 rounded-2xl bg-gray-900 border border-gray-800 text-lg font-bold text-white hover:text-primary hover:border-primary/50 hover:bg-gray-800/80 transition-all"
    >
      <span class="flex items-center gap-3">
        <span class="w-2.5 h-2.5 rounded-full bg-primary"></span>
        Serviços
      </span>
      <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>

    <a
      href="/sobre"
      class="mobile-link flex items-center justify-between p-4 rounded-2xl bg-gray-900 border border-gray-800 text-lg font-bold text-white hover:text-primary hover:border-primary/50 hover:bg-gray-800/80 transition-all"
    >
      <span class="flex items-center gap-3">
        <span class="w-2.5 h-2.5 rounded-full bg-primary"></span>
        Sobre Nós
      </span>
      <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>

    <a
      href="/contato"
      class="mobile-link flex items-center justify-between p-4 rounded-2xl bg-gray-900 border border-gray-800 text-lg font-bold text-white hover:text-primary hover:border-primary/50 hover:bg-gray-800/80 transition-all"
    >
      <span class="flex items-center gap-3">
        <span class="w-2.5 h-2.5 rounded-full bg-primary"></span>
        Contato
      </span>
      <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </nav>

  <!-- Rodapé do Menu com CTA do WhatsApp -->
  <div class="pt-5 border-t border-gray-800 space-y-4">
    <a
      href={SITE_CONFIG.whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="w-full inline-flex items-center justify-center py-4 px-6 text-base font-black text-accent bg-primary hover:bg-yellow-400 rounded-xl shadow-lg hover:scale-105 active:scale-95 transition-all text-center gap-2.5"
    >
      <svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 24 24">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
      </svg>
      Chamar no WhatsApp: {SITE_CONFIG.whatsapp}
    </a>
    <div class="flex flex-col items-center justify-center gap-1 text-xs text-gray-400 text-center">
      <span>{SITE_CONFIG.openingHours.days}</span>
      <span>Atendimento em Sorocaba, Votorantim e Região</span>
    </div>
  </div>
</div>

<script>
  const btnOpen = document.getElementById('btn-open-mobile');
  const btnClose = document.getElementById('btn-close-mobile');
  const drawer = document.getElementById('mobile-drawer');
  const links = document.querySelectorAll('.mobile-link');

  function openMenu() {
    if (drawer) {
      drawer.classList.remove('hidden');
      drawer.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeMenu() {
    if (drawer) {
      drawer.classList.remove('flex');
      drawer.classList.add('hidden');
      document.body.style.overflow = '';
    }
  }

  btnOpen?.addEventListener('click', openMenu);
  btnClose?.addEventListener('click', closeMenu);
  links.forEach((link) => {
    link.addEventListener('click', closeMenu);
  });
</script>
